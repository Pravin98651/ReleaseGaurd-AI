# ==============================================================================
# ReleaseGuard AI — Environment Configuration Template
# Copy to `.env` for local or Docker Compose runs.
# Never commit `.env` or real API tokens/keys.
# ==============================================================================

# --- Core Backend Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security & Token Encryption
# Generate ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-32-char-random-string
ENCRYPTION_KEY=

# --- Database (PostgreSQL Primary + SQLite Local Fallback) ---
POSTGRES_USER=releaseguard
POSTGRES_PASSWORD=releaseguard
POSTGRES_DB=releaseguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://releaseguard:releaseguard@postgres:5432/releaseguard

# Set USE_SQLITE_FALLBACK=true for non-Docker local runs and pytest
USE_SQLITE_FALLBACK=false
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./releaseguard_local.db

# --- Gemini AI Orchestrator (google-genai) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub Integration (OAuth + Optional Bootstrap PAT) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/settings?github_callback=1
GITHUB_PAT=

# --- Flagsmith Integration ---
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1
FLAGSMITH_EDGE_API_URL=https://edge.api.flagsmith.com/api/v1
FLAGSMITH_ORG_TOKEN=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_DEV_ENV_KEY=
FLAGSMITH_STAGING_ENV_KEY=
FLAGSMITH_PROD_ENV_KEY=

# --- Policy Engine, Bayesian Analytics & Patch Validation ---
APPROVAL_TTL_SECONDS=900
CATEGORY_B_REQUIRES_CONFIRMATION=true
BAYESIAN_MC_SAMPLES=50000
BAYESIAN_MC_SEED=42
BAYESIAN_MIN_EXPOSURES=100
EVENT_INGEST_KEY=dev-ingest-key-change-me
PATCH_VALIDATION_TIMEOUT_SECONDS=30

# --- ReleaseGuard Frontend Control Plane (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_APP_URL=http://localhost:3001

# --- Demo Application (Checkout v1 vs v2) ---
DEMO_BACKEND_PORT=8001
DEMO_FRONTEND_PORT=3001
NEXT_PUBLIC_DEMO_API_URL=http://localhost:8001
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=
FLAGSMITH_SERVER_ENV_KEY=
# Docker Compose sets RELEASEGUARD_API_URL=http://backend:8000 inside the container network.
RELEASEGUARD_API_URL=http://localhost:8000
RELEASEGUARD_INGEST_KEY=dev-ingest-key-change-me
